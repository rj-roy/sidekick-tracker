# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sidekick

# Collection names
USER_COLLECTION=users
TRACKED_EMAILS_COLL=tracked_emails
OPEN_EMAIL_COLL=email_opens
GOOGLE_ACCOUNTS_COLLECTION=google_accounts
SESSIONS_COLLECTION=sessions

# Refresh access token when it's this close (seconds) to expiring
GOOGLE_TOKEN_REFRESH_THRESHOLD=300

# Cookies (rename these to whatever you like)
RAW_COOKIE_NAME=mail_tracker_session
STATE_COOKIE_NAME=mail_tracker_oauth_state

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=<your-client-id>
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_REDIRECT_URL=http://localhost:5000/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_GMAIL_API_URL=https://gmail.googleapis.com/gmail/v1/users/me
GOOGLE_SCOPE=https://www.googleapis.com/auth/gmail.modify \
    openid \
    email \
    profile

# Session / crypto (generate with: openssl rand -base64 32)
SESSION_SECRET=<your-session-secret>
TOKEN_ENCRYPTION_KEY=<encryption-key>
SESSION_EXPIRES_IN_SECONDS=604800
# Rotate the session token after this many seconds (0 disables rotation)
SESSION_ROTATION_INTERVAL_SECONDS=86400
# Old token stays valid for this many seconds after rotation (grace window)
SESSION_ROTATION_GRACE_SECONDS=600

# CORS allowed origins (comma-separated)
APP_ORIGINS=http://localhost:5000,http://localhost:5173

# Jobs
EMAIL_POLL_INTERVAL_MS=300000
TRACKING_CLEANUP_INTERVAL_MS=86400000
TRACKING_RETENTION_DAYS=30